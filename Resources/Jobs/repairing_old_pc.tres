description = "The case barely holds together. Takes +2 damage from every hit."
is_debuff = true
modifiers = Dictionary[StringName, int]({&"damage_taken": 2})

[resource]
script = ExtResource("1_job_data")
id = &"repairing_old_pc"
display_name = "Repairing Old PC"
short_name = "PC"
flavor_text = "A beige tower from another era. It takes ten minutes to boot, hums like a jet engine, and management insists it can be saved."
max_hp = 150
hp = 150
attack = 20
attack_name = "Dust Cloud"
attack_description = "Blows years of dust at everyone once work starts. Drains Energy from every assigned girl."
abilities = Array[ExtResource("2_boss_abili")]([SubResource("Resource_1"), SubResource("Resource_2")])
status_effects = Array[ExtResource("3_status_eff")]([SubResource("Resource_3"), SubResource("Resource_4")])
