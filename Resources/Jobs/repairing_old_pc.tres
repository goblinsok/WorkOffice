[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("3_status_eff")
display_name = "Overheating"
description = "The CPU runs hot. +5 Attack."
modifiers = Dictionary[StringName, int]({&"attack": 5})

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("3_status_eff")
